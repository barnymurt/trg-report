# ─── Anthropic (Claude) ──────────────────────────────────────────────
# Separate from Claude.ai subscription — pay-as-you-go API credits
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_HAIKU=claude-3-5-haiku-latest
ANTHROPIC_MODEL_SONNET=claude-3-5-sonnet-latest
ANTHROPIC_MODEL_SONNET_THINKING=claude-3-5-sonnet-latest
# Optional: enable prompt-cache and disable training on API
ANTHROPIC_BETA=prompt-caching-2024-07-31

# ─── Local services (Docker Compose) ──────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
TEI_URL=http://localhost:8080
TEI_MODEL=BAAI/bge-small-en-v1.5
TEI_MODEL_MULTILINGUAL=BAAI/bge-m3
RERANKER_URL=http://localhost:8081
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
WHISPER_URL=http://localhost:9000
WHISPER_MODEL=distil-whisper/distil-large-v3
KOKORO_URL=http://localhost:8880
SMOLLM2_URL=http://localhost:8000
SMOLLM2_MODEL=HuggingFaceTB/SmolLM2-1.7B-Instruct
DOCLING_URL=http://localhost:5001

# ─── Routing model ────────────────────────────────────────────────────
PROJECT_CLASSIFIER_MODEL=sentence-transformers/all-MiniLM-L6-v2
COMPRESSION_MODEL=HuggingFaceTB/SmolLM2-1.7B-Instruct
FAITHFULNESS_MODEL=MoritzLaurer/DeBERTa-v3-large-mnli-fever-anli-ling-wanli

# ─── Cost / token discipline ──────────────────────────────────────────
MAX_CLAUDE_TOKENS_PER_RESPONSE=2000
COMPRESSION_TARGET_TOKENS=3000
RERANK_TOP_K=20
RERANK_FINAL_K=5
MONTHLY_BUDGET_USD=50

# ─── Audit + storage ──────────────────────────────────────────────────
AUDIT_DB_PATH=./data/audit.db
DOCUMENT_STORE_PATH=./data/documents
QDRANT_STORAGE_PATH=./data/qdrant
BACKUP_PATH=./backups

# ─── Auth (single-user) ───────────────────────────────────────────────
# Generate with: openssl rand -hex 32
APP_AUTH_TOKEN=
APP_USERNAME=

# ─── Cloudflare Tunnel (optional, for remote mobile access) ───────────
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_ID=

# ─── PWA (Next.js) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_TELEMETRY_DISABLED=true
